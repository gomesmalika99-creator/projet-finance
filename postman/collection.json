{
  "info": {
    "name": "API Client financier",
    "description": "Une demande par route + tests d'erreur 404, 409 et 422.\nLancer dans l'ordre (Run collection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "idCree",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Routes (cas qui marchent)",
      "item": [
        {
          "name": "Lister les sociétés",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/societes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "societes"
              ]
            },
            "description": "Renvoie toutes les sociétés."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"La réponse est une liste\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Lire une société",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/societes/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "societes",
                "1"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Lister les bilans d'une société",
          "request": {
            "method": "GET",
