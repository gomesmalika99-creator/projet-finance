                "bilans"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Lister les cours d'une société",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/societes/1/cours",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "societes",
                "1",
                "cours"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer une société",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/societes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "societes"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Societe Postman\",\n  \"secteur\": \"Test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"L'id de la société créée est enregistré\", function () {",
                  "    const id = pm.response.json().id;",
                  "    pm.expect(id).to.be.a(\"number\");",
                  "    pm.collectionVariables.set(\"idCree\", id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Remplacer une société",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/societes/{{idCree}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "societes",
                "{{idCree}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Societe Postman modifiee\",\n  \"secteur\": \"Test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Supprimer une société",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/societes/{{idCree}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "societes",
                "{{idCree}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Cas d'erreur",
